# Spotify app credentials (Spotify Developer Dashboard: https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Redirect URI used by the WEB backend. Must match exactly the one configured in the Spotify dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/spotify/callback
# Redirect URI used by the CLI (spotipy spawns a local HTTP server)
SPOTIFY_CLI_REDIRECT_URI=http://127.0.0.1:8888/callback

# YouTube Music OAuth credentials (Google Cloud Console).
# Create an OAuth client of type "TVs and Limited Input devices" and enable "YouTube Data API v3".
YTMUSIC_CLIENT_ID=
YTMUSIC_CLIENT_SECRET=

# Web app
APP_SECRET_KEY=change-me-to-a-long-random-string
WEB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Matching score threshold (0..1). Below this, a track is reported as unmatched.
MATCH_SCORE_THRESHOLD=0.62

# Filesystem paths
REPORTS_DIR=./reports
SECRETS_DIR=./secrets
